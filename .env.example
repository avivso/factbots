# --- YouTube upload (required only for auto-publishing) ---
# From Google Cloud console: enable "YouTube Data API v3", create an OAuth
# "Web application" client with redirect URI http://localhost:8089/callback.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Filled in for you by `npm run auth`.
YT_REFRESH_TOKEN=

# public | unlisted | private  (default: unlisted — safe for first runs)
YT_PRIVACY=unlisted

# Set to true to always render without publishing, even with creds present.
DRY_RUN=false
